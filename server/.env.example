# ==============================================================================
# SurgeWatch Backend Environment Configuration Template
# Copy this file to '.env' before starting the development server:
#   cp .env.example .env
# ==============================================================================

# Database Connection (SQLite for zero-friction local development, PostgreSQL compatible)
DATABASE_URL="file:./dev.db"

# JWT Secret for Patient & Administrator Authentication
# Replace with a strong, cryptographically secure string in production
JWT_SECRET="surgewatch_super_secure_emergency_secret_2026"

# Backend Server Listening Port
PORT=5000

# Maps & Geocoding Service API Key
MAPS_API_KEY="your_carto_maps_api_key_here"

# Optional OpenStreetMap Overpass API Mirror Override
# By default, SurgeWatch queries 'https://overpass.openstreetmap.fr/api/interpreter'
# with automated round-robin failover to other public mirrors.
# OVERPASS_API_URL="https://overpass.openstreetmap.fr/api/interpreter"
