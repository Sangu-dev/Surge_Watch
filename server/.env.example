# ==============================================================================
# SurgeWatch Backend Environment Configuration Template
# ==============================================================================

# Database Connection (Supabase PostgreSQL in production, SQLite for local testing)
# For Supabase with Connection Pooling (Transaction Mode - Port 6543):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection for Prisma Migrations & db push (Session Mode - Port 5432):
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# JWT Secret for Patient & Administrator Authentication
# Replace with a strong, cryptographically secure string in production
JWT_SECRET="surgewatch_super_secure_emergency_secret_2026"

# Backend Server Listening Port (Automatically provided by Render in production)
PORT=5000

# Maps & Geocoding Service API Key
MAPS_API_KEY="your_carto_maps_api_key_here"

# Allowed CORS Origins (Optional, default allows all)
CORS_ORIGIN="https://surgewatch.vercel.app"

# Optional OpenStreetMap Overpass API Mirror Override
# By default, SurgeWatch queries 'https://overpass.openstreetmap.fr/api/interpreter'
# with automated round-robin failover to other public mirrors.
# OVERPASS_API_URL="https://overpass.openstreetmap.fr/api/interpreter"
