# SurgeWatch Staging Environment Template
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# Duplicate this file to .env.staging and populate with isolated staging credentials

NODE_ENV=staging
PORT=5001

# ISOLATED STAGING POSTGRESQL DATABASE (Must NEVER match production)
# Example for Supabase Staging Project:
# DATABASE_URL="postgresql://postgres.[STAGING_REF]:[STAGING_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# DIRECT_URL="postgresql://postgres.[STAGING_REF]:[STAGING_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

DATABASE_URL="postgresql://postgres.staging-project-ref:staging-password@staging-host:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.staging-project-ref:staging-password@staging-host:5432/postgres"

# Staging Authentication & Security
JWT_SECRET="staging-only-high-entropy-jwt-secret-minimum-64-characters-long-example"
CLIENT_ORIGIN="http://localhost:5173,https://staging.surgewatch.in"
FRONTEND_URL="https://staging.surgewatch.in"
TRUST_PROXY=true

# Optional Staging SMTP (Can use Ethereal or test inbox)
# SMTP_HOST="smtp.ethereal.email"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="SurgeWatch Staging <no-reply@staging.surgewatch.in>"

