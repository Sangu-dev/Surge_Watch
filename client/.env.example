# Backend API & WebSocket URLs (Set to your Render backend URL in production, e.g. https://surgewatch-api.onrender.com)
VITE_API_BASE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# CARTO Maps API Key for basemap tiles
VITE_MAPS_API_KEY=your_carto_maps_api_key_here

# Optional Custom Tile URL template (supports {key} or {apiKey})
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key={key}

